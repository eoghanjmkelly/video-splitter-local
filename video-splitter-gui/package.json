{
  "name": "video-splitter-gui",
  "version": "2.0.3",
  "description": "Electron GUI for local video splitting into ~1.5GB chunks.",
  "main": "main.js",
  "homepage": "https://github.com/eoghanjmkelly/video-splitter-local",
  "repository": {
    "type": "git",
    "url": "https://github.com/eoghanjmkelly/video-splitter-local.git"
  },
  "scripts": {
    "start": "electron .",
    "pack": "electron-packager . VideoSplitterGUI --platform=win32 --arch=x64 --out=dist --overwrite",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --x64 --publish never",
    "dist:linux": "electron-builder --linux --x64 --publish never",
    "dist": "electron-builder --win --mac --linux --x64 --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "^5.0.0",
    "ffprobe-static": "^3.1.0",
    "pretty-bytes": "^6.0.0"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^26.0.12",
    "electron-packager": "^17.1.1"
  },
  "build": {
    "appId": "com.eoghanjmkelly.videosplittergui",
    "productName": "VideoSplitterGUI",
    "files": [
      "**/*",
      "!dist",
      "!node_modules/.cache"
    ],
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VideoSplitterGUI"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "${productName}-mac.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb", "rpm"],
      "category": "Utility",
      "artifactName": "${productName}-${os}-${arch}.${ext}",
      "maintainer": "eoghanjmkelly <eoghanjmkelly@users.noreply.github.com>"
    }
  },
  "author": "eoghanjmkelly <eoghanjmkelly@users.noreply.github.com>",
  "license": "MIT"
}
