{
  "name": "video-merger-gui",
  "version": "1.0.0",
  "description": "Electron GUI for merging multiple videos into one.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-packager . VideoMergerGUI --platform=win32 --arch=x64 --out=dist --overwrite",
    "dist:win": "electron-builder --win --x64",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "ffmpeg-static": "^5.0.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^26.0.12",
    "electron-packager": "^17.1.1"
  },
  "build": {
    "appId": "com.eoghanjmkelly.videomergertgui",
    "productName": "VideoMergerGUI",
    "files": [
      "**/*",
      "!dist",
      "!node_modules/.cache"
    ],
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg.exe"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "mac": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VideoMergerGUI"
    }
  },
  "author": "",
  "license": "MIT"
}
